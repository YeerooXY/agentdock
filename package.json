{
  "name": "agent-dock",
  "productName": "Agent Dock",
  "version": "0.2.0",
  "private": true,
  "description": "A local desktop home for agent sessions, usage and API calls.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "pack": "npm run build && npm run prepare:runtime && electron-builder --dir --win --x64",
    "dist": "npm run build && npm run prepare:runtime && electron-builder --win --x64 --publish never && node scripts/checksum.cjs",
    "test:packaged": "node scripts/packaged-smoke.cjs"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "node-pty": "1.1.0"
  },
  "author": "YeerooXY",
  "repository": {
    "type": "git",
    "url": "https://github.com/YeerooXY/agentdock.git"
  }
}
