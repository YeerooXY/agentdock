{
  "catalog": [
    {
      "id": "codex",
      "name": "Codex",
      "command": "codex",
      "script": "https://chatgpt.com/codex/install.ps1",
      "shScript": "https://chatgpt.com/codex/install.sh",
      "docs": "https://learn.chatgpt.com/docs/codex/cli",
      "auth": "Sign in with ChatGPT in your console.",
      "native": true
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "command": "claude",
      "script": "https://claude.ai/install.ps1",
      "shScript": "https://claude.ai/install.sh",
      "docs": "https://code.claude.com/docs/en/setup",
      "auth": "Sign in with your Claude account in your console.",
      "native": true
    },
    {
      "id": "antigravity",
      "name": "Google Antigravity",
      "command": "agy",
      "script": "https://antigravity.google/cli/install.ps1",
      "shScript": "https://antigravity.google/cli/install.sh",
      "installArgs": [
        "--skip-path"
      ],
      "docs": "https://antigravity.google/docs/cli/install/",
      "auth": "Sign in with Google when the CLI opens.",
      "mcp": ".gemini/config/mcp_config.json",
      "windowsBuild": 22000,
      "unrestricted": [
        "--dangerously-skip-permissions"
      ]
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot",
      "command": "copilot",
      "npm": "@github/copilot",
      "docs": "https://docs.github.com/en/copilot/get-started/cli-quickstart",
      "auth": "Use /login with your GitHub account.",
      "model": "--model",
      "unrestricted": [
        "--allow-all"
      ],
      "native": true
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "command": "opencode",
      "npm": "opencode-ai",
      "docs": "https://opencode.ai/docs/",
      "auth": "Use /connect to choose your provider, including Z.AI.",
      "model": "--model",
      "native": true,
      "unrestricted": [
        "--auto"
      ]
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "command": "agent",
      "aliases": [
        "cursor-agent"
      ],
      "script": "https://cursor.com/install?win32=true",
      "shScript": "https://cursor.com/install",
      "docs": "https://cursor.com/docs/cli/installation",
      "auth": "Sign in with Cursor when the CLI opens.",
      "model": "--model",
      "mcp": ".cursor/mcp.json",
      "unrestricted": [
        "--force"
      ]
    },
    {
      "id": "grok",
      "name": "Grok Build",
      "command": "grok",
      "script": "https://x.ai/cli/install.ps1",
      "shScript": "https://x.ai/cli/install.sh",
      "docs": "https://docs.x.ai/build/overview",
      "auth": "Sign in with your xAI account when prompted.",
      "model": "--model",
      "unrestricted": [
        "--always-approve"
      ],
      "mcp": ".grok/config.toml"
    },
    {
      "id": "kiro",
      "name": "Kiro",
      "command": "kiro-cli",
      "script": "https://cli.kiro.dev/install.ps1",
      "shScript": "https://cli.kiro.dev/install",
      "docs": "https://kiro.dev/docs/cli/setup/",
      "auth": "Run kiro-cli login, or sign in when the chat opens.",
      "args": [
        "chat"
      ],
      "model": "--model",
      "mcp": ".kiro/settings/mcp.json",
      "windowsBuild": 22000,
      "unrestricted": [
        "--trust-tools=fs_read,fs_write"
      ]
    },
    {
      "id": "qwen",
      "name": "Qwen Code",
      "command": "qwen",
      "npm": "@qwen-code/qwen-code",
      "docs": "https://qwenlm.github.io/qwen-code-docs/en/users/quickstart/",
      "auth": "Run /auth to choose QwenCloud, ModelStudio, a provider or a custom endpoint. Qwen OAuth ended April 15, 2026.",
      "model": "--model",
      "native": true,
      "unrestricted": [
        "--approval-mode",
        "yolo"
      ]
    },
    {
      "id": "kimi",
      "name": "Kimi Code",
      "command": "kimi",
      "script": "https://code.kimi.com/kimi-code/install.ps1",
