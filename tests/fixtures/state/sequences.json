  {
    "name": "reset then patch then replace",
    "view": "desktop",
    "description": "Fresh client: welcome, resets, a patch with implicit order, a value replace.",
    "start": {
      "view": "desktop",
      "epoch": null,
      "subscription": null,
      "slices": [],
      "revs": {},
      "values": {},
      "lastBatch": 0
    },
    "steps": [
      {
        "message": {
          "type": "welcome",
          "protocol": 2,
          "epoch": "epoch-a",
          "subscription": "sub-1",
          "slices": [
            "sessions",
            "tasks",
            "usage"
          ],
          "compression": "none"
        },
        "expect": {
          "outcome": "welcome",
          "state": {
            "view": "desktop",
            "epoch": "epoch-a",
            "subscription": "sub-1",
            "slices": [
              "sessions",
              "tasks",
              "usage"
            ],
            "revs": {},
            "values": {},
            "lastBatch": 0
          }
        }
      },
      {
        "message": {
          "type": "changes",
          "epoch": "epoch-a",
          "subscription": "sub-1",
          "batch": 1,
          "changes": [
            {
              "kind": "reset",
              "slice": "sessions",
              "rev": 3,
              "value": {
                "byId": {
                  "a": {
                    "id": "a",
                    "name": "A"
                  },
                  "b": {
                    "id": "b",
                    "name": "B"
                  }
                },
                "order": [
                  "a",
                  "b"
                ],
                "meta": {}
              }
            },
            {
              "kind": "reset",
              "slice": "tasks",
              "rev": 0,
              "value": {
                "byId": {},
                "order": [],
                "meta": {}
              }
            },
            {
              "kind": "reset",
              "slice": "usage",
              "rev": 1,
              "value": {
                "accounts": []
