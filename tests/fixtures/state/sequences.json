              "sessions",
              "tasks",
              "usage"
            ],
            "revs": {
              "sessions": 3,
              "tasks": 0,
              "usage": 1
            },
            "values": {
              "sessions": {
                "byId": {
                  "a": {
                    "id": "a",
                    "name": "A"
                  },
                  "b": {
                    "id": "b",
                    "name": "B"
                  }
                },
                "order": [
                  "a",
                  "b"
                ],
                "meta": {}
              },
              "tasks": {
                "byId": {},
                "order": [],
                "meta": {}
              },
              "usage": {
                "accounts": []
              }
            },
            "lastBatch": 1
          }
        }
